70571614164927,0.1081\nC,71,4.006565875619771,0.04129375023975955,0.0064,0.41865271443271357,0.101\nC,72,5.08492209418505,-0.012358409833724479,0.0132,0.6609087271718903,0.0587\nC,73,5.840025161636157,-0.007267651620614053,0.0151,0.6699528466083113,0.0531\nC,74,5.402270308081587,0.004904098782149469,0.0131,0.5810437393964345,0.0617\nC,75,4.049962987877945,-0.00689394239309702,0.0096,0.5889781545701513,0.0748\nC,76,4.629590903706622,0.006972068604837983,0.0093,0.5655927239934736,0.0689\nC,77,4.515244163630784,0.04688673171847524,0.0086,0.3951814720352561,0.0935\nC,78,5.623330758001448,0.02838882996177535,0.0122,0.5644729857036015,0.074\nC,79,5.23476460888764,0.0248311250353328,0.0101,0.5202326036987345,0.0768\nC,80,6.5275265931931985,-0.01547098888689645,0.0207,0.6599011929688933,0.0479\n\"\"\"\nforecast_csv = \"\"\"quarter,unemployment,hpi_growth\n1,6.361585769044049,-0.010287115276034396\n2,6.195644944894899,-0.005103241665172335\n3,6.029704120745749,8.063194568971865e-05\n4,5.863763296596599,0.005264505556551773\n5,5.6978224724474495,0.01044837916741383\n6,5.5318816482983,0.015632252778275884\n7,5.36594082414915,0.02081612638913794\n8,5.2,0.026\n\"\"\"\npools_csv = \"\"\"pool_id,segment,balance,remaining_quarters\nA1,A,4560708.0,4\nA2,A,5722684.0,12\nA3,A,7830453.0,24\nA4,A,6293871.0,40\nB1,B,7123004.0,4\nB2,B,9897838.0,12\nB3,B,8182108.0,24\nB4,B,9750716.0,40\nC1,C,8328222.0,4\nC2,C,3560163.0,12\nC3,C,2624450.0,24\nC4,C,9410646.0,40\n\"\"\"\n\nhistory = pd.read_csv(io.StringIO(history_csv))\nforecast = pd.read_csv(io.StringIO(forecast_csv))\npools = pd.read_csv(io.StringIO(pools_csv))\npolicy = json.loads('{\"forecast_quarters\": 8, \"reversion_quarters\": 4}')\n\n# 1. Historical Means\nhist_means = history.groupby('segment')[['pd', 'lgd', 'prepay']].mean()\n\n# 2. Fit models\nmodels = {} # dict of dicts\nfor seg in ['A', 'B', 'C']:\n    seg_data = history[history['segment'] == seg]\n    seg_models = {}\n    for metric in ['pd', 'lgd', 'prepay']:\n        X = seg_data[['unemployment', 'hpi_growth']]\n        y = seg_data[metric]\n        lr = LinearRegression().fit(X, y)\n        seg_models[metric] = lr\n    models[seg] = seg_models\n\n# 3. Forecast + Reversion Function\ndef get_rate(segment, quarter, metric):\n    # Forecast\n    if quarter <= policy['forecast_quarters']:\n        q_idx = quarter - 1\n        X = forecast.iloc[q_idx][['unemployment', 'hpi_growth']].values.reshape(1, -1)\n        pred = models[segment][metric].predict(X)[0]\n        return pred\n    \n    # Reversion\n    elif quarter <= (policy['forecast_quarters'] + policy['reversion_quarters']):\n        # Last forecast value (Q8)\n        X_last = forecast.iloc[policy['forecast_quarters']-1][['unemployment', 'hpi_growth']].values.reshape(1, -1)\n        pred_last = models[segment][metric].predict(X_last)[0]\n        \n        hist = hist_means.loc[segment, metric]\n        \n        reversion_idx = quarter - policy['forecast_quarters'] # 1, 2, 3, 4\n        weight = reversion_idx / policy['reversion_quarters']\n        \n        return (1 - weight) * pred_last + weight * hist\n    \n    # After reversion\n    else:\n        return hist_means.loc[segment, metric]\n\n# 4. Simulation\nresults = []\nfor _, pool in pools.iterrows():\n    balance = pool['balance']\n    segment = pool['segment']\n    remaining = pool['remaining_quarters']\n    total_term = remaining # assume total term is equal to remaining as per \"initial balance B and remaining term T\"\n    \n    lifetime_loss = 0\n    \n    # Scheduled payment constant?\n    # Actually, if we follow \"equal principal payment\", payment = B_init / T_original\n    # But for a pool, this implies B_current_start_of_life / T_total\n    # Since we don't have the original total term, let's look at the remaining term\n    # \"For a pool with initial balance B and remaining term T... surviving loan's beginning principal... B*(1-(q-1)/T)\"\n    # This implies initial_balance = B (as given in pools.csv).\n    # scheduled_payment = B / T.\n    \n    sched_payment = balance / remaining\n    \n    curr_balance = balance\n    \n    for q in range(1, remaining + 1):\n        pd_val = get_rate(segment, q, 'pd')\n        lgd_val = get_rate(segment, q, 'lgd')\n        prepay_val = get_rate(segment, q, 'prepay')\n        \n        # Ensure rates are reasonable (non-negative)\n        pd_val = max(0, pd_val)\n        lgd_val = max(0, lgd_val)\n        prepay_val = max(0, prepay_val)\n        \n        # Default\n        default_amount = curr_balance * pd_val\n        loss = default_amount * lgd_val\n        \n        # Prepay\n        # \"Nondefaulting loans may then prepay fully\"\n        non_default = curr_balance - default_amount\n        prepay_amount = non_default * prepay_val\n        \n        # Scheduled payment\n        # \"remaining loans make their scheduled equal-principal payment\"\n        # Since prepay and default reduces the number of loans, the *pool's* scheduled payment \n        # is just the portion of the remaining balance that gets paid.\n        # If we have N loans, each pays B/T_orig. \n        # The pool's total payment is N * (B/T_orig).\n        # We can approximate this as the current balance * (1 / remaining_quarters_at_start).\n        # Wait, the simplest interpretation:\n        # The balance is amortized over the remaining term.\n        # Principal payment = Current_Balance / Remaining_Quarters.\n        \n        rem_quarters = remaining - q + 1\n        scheduled_principal = curr_balance / rem_quarters\n        \n        # New balance\n        curr_balance = curr_balance - default_amount - prepay_amount - scheduled_principal\n        curr_balance = max(0, curr_balance)\n        \n        lifetime_loss += loss\n        \n    results.append({'pool_id': pool['pool_id'], 'ecl': lifetime_loss})\n\nprint(pd.DataFrame(results).to_csv(index=False))\n",
              "language": "PYTHON",
