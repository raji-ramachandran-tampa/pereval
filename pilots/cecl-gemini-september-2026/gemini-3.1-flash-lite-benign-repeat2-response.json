c] = model_object\nfor seg in ['A', 'B', 'C']:\n    models[seg] = {}\n    seg_data = history[history['segment'] == seg]\n    X = seg_data[['unemployment', 'hpi_growth']]\n    for metric in ['pd', 'lgd', 'prepay']:\n        y = seg_data[metric]\n        reg = LinearRegression().fit(X, y)\n        models[seg][metric] = reg\n\n# 3. Forecast rates for each segment\n# We need to forecast for the maximum remaining term (40)\nmax_term = 40\nforecast_len = policy['forecast_quarters']\nrev_len = policy['reversion_quarters']\n\nprojected_rates = {} # dict[segment] -> dict[metric] -> list of length 40\nfor seg in ['A', 'B', 'C']:\n    projected_rates[seg] = {}\n    for metric in ['pd', 'lgd', 'prepay']:\n        rates = []\n        # First 8 quarters (forecast period)\n        for i in range(forecast_len):\n            row = forecast.iloc[i][['unemployment', 'hpi_growth']].values.reshape(1, -1)\n            pred = models[seg][metric].predict(row)[0]\n            rates.append(pred)\n        \n        last_forecast = rates[-1]\n        hist_mean = hist_means.loc[seg, metric]\n        \n        # Next 4 quarters (reversion period)\n        # linear blend from last_forecast to hist_mean\n        for i in range(1, rev_len + 1):\n            weight = i / rev_len\n            val = (1 - weight) * last_forecast + weight * hist_mean\n            rates.append(val)\n            \n        # Afterward: hold historical mean\n        while len(rates) < max_term:\n            rates.append(hist_mean)\n        \n        projected_rates[seg][metric] = rates\n\n# 4. Calculate ECL for each pool\nresults = []\nfor _, pool in pools.iterrows():\n    segment = pool['segment']\n    balance = pool['balance']\n    term = int(pool['remaining_quarters'])\n    \n    total_ecl = 0\n    # Beginning balance logic\n    # surviving loan's beginning principal in quarter q (1-based) is B*(1-(q-1)/T)\n    # Default occurs first on beginning principal.\n    # Nondefaulting loans may then prepay fully; remaining loans make their scheduled equal-principal payment.\n    # Neither defaulted nor prepaid loans re-enter.\n    \n    curr_balance = balance\n    # Scheduled principal payment per quarter = Initial / Term\n    scheduled_pmt = balance / term\n    \n    for q in range(1, term + 1):\n        # Rates for this quarter (0-indexed list, q=1 is index 0)\n        pd_q = projected_rates[segment]['pd'][q-1]\n        lgd_q = projected_rates[segment]['lgd'][q-1]\n        prepay_q = projected_rates[segment]['prepay'][q-1]\n        \n        # \"a surviving loan's beginning principal... is B*(1-(q-1)/T)\"\n        # Wait, the prompt says \"a surviving loan's beginning principal in quarter q... is B*(1-(q-1)/T)\"\n        # This implies we are tracking a single loan, not the aggregate pool.\n        # But we have pool balances.\n        # Re-reading: \"For a pool with initial balance B and remaining term T, a surviving loan's \n        # beginning principal in quarter q (1-based) is B*(1-(q-1)/T).\"\n        # Actually, this is the remaining principal balance of the pool assuming NO prepayments/defaults,\n        # but the prompt describes it as the *starting balance of the pool in that quarter*.\n        \n        # Let's use the standard pool amortization formula:\n        # P_start_q = B * (1 - (q-1)/T)\n        # Defaults_q = P_start_q * PD_q\n        # Remaining_q = P_start_q - Defaults_q\n        # Prepayments_q = Remaining_q * Prepay_q\n        # Actually, standard assumption: prepayments happen on the remaining balance AFTER defaults.\n        # The prompt says: \"Default occurs first on beginning principal. Nondefaulting loans may then prepay fully;\n        # remaining loans make their scheduled equal-principal payment.\"\n        \n        # Let's interpret \"surviving loan's beginning principal\" as the pool's scheduled balance at the start of q.\n        # Wait, \"For a pool... a surviving loan's beginning principal... is B*(1-(q-1)/T)\".\n        # This wording suggests tha